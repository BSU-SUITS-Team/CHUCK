# Default setup uses Ollama's OpenAI-compatible API through fast-agent's
# generic provider. Override these if your server is elsewhere.
# GENERIC_API_KEY=ollama
# GENERIC_BASE_URL=http://localhost:11434/v1

# Optional default used by `llm-chat` when --model is not supplied.
# LLM_CHAT_MODEL=generic.qwen3.6:35b-a3b?reasoning=off

# Optional mission context defaults.
# GROUND_CONTROL_API_URL=http://localhost:8181
# TSS_ENDPOINT=http://localhost:14141
# LLM_CHAT_USER_EVA=eva1

# Optional voice input defaults used with `llm-chat --voice`.
# LLM_CHAT_WHISPER_MODEL=tiny.en
# LLM_CHAT_WHISPER_DEVICE=auto
# LLM_CHAT_WHISPER_LANGUAGE=en
# LLM_CHAT_REALTIME_INTERVAL=0.25
# LLM_CHAT_REALTIME_WINDOW=2.0
# LLM_CHAT_COMMIT_INTERVAL=1.5
# LLM_CHAT_KEEP_OVERLAP=0.2
